# Server
PORT=3000
NODE_ENV=production

# Database (Supabase / PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/dbname?pgbouncer=true"

# Optional local DB config (if not using DATABASE_URL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=postgres
DB_SYNCHRONIZE=false
DB_SSL=true

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-domain.vercel.app/api/v1/auth/google/callback

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d

# Supabase Storage (file uploads - giấy tờ, ảnh đính kèm)
# SUPABASE_URL: lấy trong Supabase Dashboard > Project Settings > API
# SUPABASE_SERVICE_ROLE_KEY: dùng service_role key (không phải anon key) để bypass RLS khi upload từ server
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=family-mgmt-assets

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend.vercel.app

# OpenAI (for natural language parsing)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini  # optional, defaults to gpt-4o-mini
