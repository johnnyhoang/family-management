# ========================================================
# BIẾN MÔI TRƯỜNG DÙNG CHO SERVER NESTJS
# ========================================================

# 1. Cấu hình Máy chủ & CORS
PORT=3173
NODE_ENV=production
FRONTEND_URL=https://your-domain.vercel.app

# 2. Database (PostgreSQL / Supabase Transaction Pooler)
DATABASE_URL=postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DB_PREFIX=fm_
DB_SYNCHRONIZE=false
DB_SSL=true

# 3. JWT Security
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d

# 4. Supabase Integration (Auth & Storage)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=family-mgmt-assets

# 5. Vite Frontend Fallbacks
VITE_SUPABASE_URL=https://[PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# 6. OpenAI Integration (Optional)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
