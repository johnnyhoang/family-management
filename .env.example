# ========================================================
# BIẾN MÔI TRƯỜNG DÙNG ĐỂ DEPLOY TRÊN VERCEL (TỐI GIẢN)
# ========================================================

# 1. Database (PostgreSQL / Supabase Transaction Pooler)
DATABASE_URL=postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DB_PREFIX=fm_

# 2. Supabase API (Dùng cho Google Auth & Storage)
# Lấy tại Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=ey...

# 3. JWT Secret (Chuỗi ngẫu nhiên bảo mật nội bộ)
JWT_SECRET=super_random_jwt_secret_key_123456
