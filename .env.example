# ========================================================
# BIẾN MÔI TRƯỜNG DÙNG CHO LOCAL HOẶC DEPLOY VERCEL
# ========================================================

# 1. Cổng máy chủ & Frontend (Local Dev)
PORT=3173
FRONTEND_URL=http://localhost:5173

# 2. Kết nối Database (Supabase PostgreSQL / Transaction Pooler)
DATABASE_URL=postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DB_PREFIX=fm_

# 3. Supabase API (Dùng cho Google Auth & Storage)
# Lấy tại Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_STORAGE_BUCKET=family-mgmt-assets

# 4. Biến cho Frontend (Vite Frontend Google Auth)
VITE_SUPABASE_URL=https://[PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# 5. JWT Secret nội bộ
JWT_SECRET=super_random_jwt_secret_key_123456
JWT_EXPIRES_IN=1h

# 6. OpenAI (Tùy chọn - nhận diện nhập liệu thông minh bằng tiếng Việt)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=your-gemini-api-key

